{
  "name": "obsidian-task-trellis",
  "version": "0.1.13",
  "description": "Manage tasks across your notes with configurable kanban boards, due-date rows, colored labels, and mobile task capture.",
  "main": "main.js",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "harness": "node esbuild.config.mjs harness",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint main.ts src package.json --max-warnings 0",
    "check:release": "node scripts/check-release.mjs",
    "package": "npm run build && node scripts/check-release.mjs --package",
    "benchmark": "node scripts/benchmark.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "monkey-around": "^3.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@eslint/json": "^0.14.0",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "jsdom": "^26.1.0",
    "obsidian": "1.8.7",
    "tslib": "^2.6.3",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "overrides": {
    "moment": "^2.31.0"
  }
}
